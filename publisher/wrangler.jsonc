{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "franz-lola-publisher",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": [
      "GITHUB_APP_ID",
      "GITHUB_APP_CLIENT_ID",
      "GITHUB_APP_CLIENT_SECRET",
      "GITHUB_INSTALLATION_ID",
      "GITHUB_APP_PRIVATE_KEY",
      "SESSION_SECRET",
      "ALLOWED_GITHUB_LOGINS"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "MatthaeusStumptner",
    "GITHUB_REPO": "Geburtstagsspiel",
    "GITHUB_BASE_BRANCH": "main",
    "EDITOR_ORIGIN": "https://matthaeusstumptner.github.io",
    "EDITOR_PATH_PREFIX": "/Pacman_clone_level_editor/",
    "GAME_URL": "https://matthaeusstumptner.github.io/Geburtstagsspiel/"
  }
}
