{
  "name": "franz-lola-level-editor",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "catalog:generate": "node scripts/generate-game-catalog.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.js",
    "test:all": "npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@franz-lola/pixel-renderer": "github:MatthaeusStumptner/Pacman_clone_renderer#f728829",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "vite": "^6.4.3"
  }
}
